default_location=./Journal

// d/mm/yyyy   = 3/06/2024
// dd/mm/yyyy  = 03/06/2024
// d/m/yyyy    = 3/6/2024
// d/m/yy      = 3/6/24
// yyyy-mm-d  = 2024-06-3
date_style=yyyy-mm-d

// hh:mm-ampm  = 04:15 pm
// h:mm-ampm   = 4:15 pm
// h:mm-AMPM   = 4:15 PM
// hh:mm       = 16:15
time_style=h:mm-AMPM

// platforms="plat1", "plat2", "plat*"
// platforms="Mastodon", "Twitter", "Pixelfed"
platforms="Mastodon"

